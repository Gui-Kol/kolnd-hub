{
  "name": "@lizardbyte/KLOUD_GAMES",
  "version": "0.0.0",
  "description": "Prebuilt web UI assets for the KLOUD_GAMES game-stream host",
  "license": "GPL-3.0-only",
  "funding": "https://app.lizardbyte.dev",
  "homepage": "https://KLOUD_GAMES.lizardbyte.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KLOUD_GAMESStream/KLOUD_GAMES.git"
  },
  "bugs": {
    "url": "https://github.com/KLOUD_GAMESStream/KLOUD_GAMES/issues"
  },
  "files": [
    "build/assets/web/"
  ],
  "scripts": {
    "build": "vite build --debug",
    "build-clean": "vite build --debug --emptyOutDir",
    "dev": "vite build --watch",
    "serve": "serve ./tests/fixtures/http --no-port-switching",
    "test": "vitest run --coverage"
  },
  "type": "module",
  "dependencies": {
    "@intlify/message-compiler": "11.4.18",
    "@lucide/vue": "1.71.0",
    "dompurify": "^3.4.18",
    "marked": "18.0.12",
    "vue": "3.5.45",
    "vue-i18n": "11.4.18",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@codecov/vite-plugin": "2.0.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "jsdom": "31.0.0",
    "serve": "14.2.6",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@codecov/vite-plugin": {
      "vite": "$vite"
    }
  }
}
