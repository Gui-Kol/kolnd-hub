if (WIN32)
elseif (APPLE)
    if (NOT KLOUD_GAMES_BUILD_HOMEBREW)
        set(CMAKE_BUILD_WITH_INSTALL_RPATH ON)
        set(CMAKE_INSTALL_RPATH "")
        set(CMAKE_INSTALL_RPATH_USE_LINK_PATH FALSE)
    endif()
elseif (UNIX)
    include(GNUInstallDirs)

    if(NOT DEFINED KLOUD_GAMES_EXECUTABLE_PATH)
        set(KLOUD_GAMES_EXECUTABLE_PATH "KLOUD_GAMES")
    endif()

    if(KLOUD_GAMES_BUILD_FLATPAK)
        set(KLOUD_GAMES_SERVICE_START_COMMAND "ExecStart=flatpak run --command=KLOUD_GAMES ${PROJECT_FQDN}")
        set(KLOUD_GAMES_SERVICE_STOP_COMMAND "ExecStop=flatpak kill ${PROJECT_FQDN}")
    else()
        set(KLOUD_GAMES_SERVICE_START_COMMAND "ExecStart=${KLOUD_GAMES_EXECUTABLE_PATH}")
        set(KLOUD_GAMES_SERVICE_STOP_COMMAND "")
    endif()
endif()
